%% Mapa ekranów i sterowania (moduł nawigacji). Przykład do zastąpienia własną mapą.
%% Konwencje (czyta je check.py):
%%   klasa screen   = ekran z paskiem nawigacji (z każdego dostępne NAV)
%%   klasa modal    = przepływ pełnoekranowy bez paska; wyjście tylko krawędzią -.->
%%   klasa success  = ekran zakończenia celu; zasada „prowadzenie do postępu” wymaga wezwania ==>
%%   klasa external = aplikacja spoza systemu
%%   -->  zwykłe przejście     ==>  wezwanie do działania     -.->  wyjście / powrót
%%   %% exception-dp01: Enn (D-nn) = świadomy wyjątek od reguły R5
%%   %% E-nn realizes: UC-nn        = ślad ekranu do przypadku użycia (R7, process/tools/id.toml)
%%   %% E-nn status: initiated      = stan produktu pracy (obowiązkowy)
%%   %% key-pair: Enn Enn opis     = para ekranów do pomiaru liczby kliknięć (R6)
%% key-pair: E01 E03 Start → szczegóły
%% E-01 realizes: UC-01
%% E-01 status: initiated
%% E-02 realizes: UC-01
%% E-02 status: initiated
%% E-03 realizes: UC-01
%% E-03 status: initiated
%% E-04 realizes: UC-01
%% E-04 status: initiated
%% E-05 realizes: UC-01
%% E-05 status: initiated
flowchart LR
  NAV(["Pasek: Start · Lista · (+)"])

  E01["E-01 Start"]
  E02["E-02 Lista"]
  E03["E-03 Szczegóły"]
  E04["E-04 Formularz"]
  E05(["E-05 Zapisano"])

  NAV --> E01
  NAV --> E02
  NAV -->|"(+)"| E04

  E01 ==>|"Wezwanie: dokończ"| E03
  E01 -->|"Lista"| E02
  E02 -->|"Element"| E03
  E03 -.->|"Wstecz"| E02
  E03 -->|"Edytuj"| E04
  E04 ==>|"Zapisz"| E05
  E04 -.->|"Anuluj"| E01
  E05 ==>|"Pokaż element"| E03
  E05 -->|"Start"| E01

  classDef screen fill:#e8eef6,stroke:#3d5a80,color:#1b2635
  classDef modal fill:#fdf0d5,stroke:#b07d18,color:#3a2a06
  classDef success fill:#dff1e3,stroke:#2f7d4a,color:#12301c
  classDef external fill:#eeeeee,stroke:#777777,color:#222222,stroke-dasharray:4 3
  classDef nav fill:#3d5a80,stroke:#3d5a80,color:#ffffff
  class E01,E02,E03 screen
  class E04 modal
  class E05 success
  class NAV nav
