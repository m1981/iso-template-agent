#!/bin/sh
# Pre-commit (AGENTS.md, P-05):
#  1. ślad według tools/id.toml (tools/trace.py) i aktualność trace.md,
#  2. jeśli jest plan.md: aktualność progress.md (tools/progress.py),
#  2a. aktualność iso-map.html (tools/iso_map.py),
#  3. jeśli wdrożono moduł nawigacji: reguły mapy i aktualność navigation-map.html.
# Sprawdza pliki w katalogu roboczym. Włączenie w nowym klonie: make hooks
cd "$(git rev-parse --show-toplevel)" || exit 1

tmp=$(mktemp)
if ! python3 -B tools/trace.py "$tmp" > "$tmp.log"; then
  grep '^E' "$tmp.log"
  echo
  echo "pre-commit: ślad ma błędy (powyżej). Popraw artefakty albo tools/id.toml."
  rm -f "$tmp" "$tmp.log"; exit 1
fi
if ! cmp -s "$tmp" trace.md; then
  rm -f "$tmp" "$tmp.log"
  echo "pre-commit: trace.md jest nieaktualny. Uruchom: make trace i dodaj plik do commita."
  exit 1
fi
rm -f "$tmp" "$tmp.log"

if [ -f plan.md ]; then
  tmp=$(mktemp)
  python3 -B tools/progress.py "$tmp" > /dev/null
  if ! cmp -s "$tmp" progress.md; then
    rm -f "$tmp"
    echo "pre-commit: progress.md jest nieaktualny. Uruchom: make progress i dodaj plik do commita."
    exit 1
  fi
  rm -f "$tmp"
fi

tmp=$(mktemp)
python3 -B tools/iso_map.py "$tmp" > /dev/null
if ! cmp -s "$tmp" iso-map.html; then
  rm -f "$tmp"
  echo "pre-commit: iso-map.html jest nieaktualna. Uruchom: make iso-map i dodaj plik do commita."
  exit 1
fi
rm -f "$tmp"

if [ -d navigation ]; then
  cd navigation || exit 1
  if ! python3 -B check.py screens.mmd > /dev/null; then
    python3 -B check.py screens.mmd | grep -E 'Reguła|---|UWAGA'
    echo
    echo "pre-commit: mapa nawigacji łamie reguły (wiersze UWAGA powyżej)."
    exit 1
  fi
  tmp=$(mktemp)
  python3 -B build.py "$tmp" > /dev/null
  if ! cmp -s "$tmp" navigation-map.html; then
    rm -f "$tmp"
    echo "pre-commit: navigation/navigation-map.html jest nieaktualna. Uruchom: make navigation i dodaj plik."
    exit 1
  fi
  rm -f "$tmp"
fi
exit 0
