digraph controls {
 graph [rankdir=TB, bgcolor=white, pad="0.3", nodesep="0.42", ranksep="0.55", outputorder=edgesfirst, fontname="Arial"];
 node [shape=box, style="rounded,filled", fillcolor="#eef3f6", color="#64808c", fontname="Arial", fontsize=15, margin="0.18,0.14", width=3.0];
 edge [color="#60717a", arrowsize=0.7];
 h0 [label="MOMENT PRACY", fillcolor="#183c4a", fontcolor=white];
 h1 [label="OBECNA OCHRONA", fillcolor="#183c4a", fontcolor=white];
