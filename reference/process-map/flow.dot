digraph flow {
 graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.42", ranksep="0.65", splines=polyline, outputorder=edgesfirst, fontname="Arial"];
 node [shape=box, style="rounded,filled", fillcolor="#fff5df", color="#ad7830", fontname="Arial", fontsize=15, margin="0.18,0.14", width=2.65];
 edge [color="#60717a", arrowsize=0.7, fontname="Arial", fontsize=11];
 hu [label="OPERATOR\ncel, zakres i decyzje", fillcolor="#183c4a", fontcolor=white, color="#183c4a", group=u];
 ha [label="AGENT WYKONUJĄCY\nPM / analiza / development", fillcolor="#183c4a", fontcolor=white, color="#183c4a", group=a];
 hr [label="RECENZENT\nosobny przebieg", fillcolor="#183c4a", fontcolor=white, color="#183c4a", group=r];
 ht [label="NARZĘDZIA SZABLONU\nwybrane kontrole", fillcolor="#183c4a", fontcolor=white, color="#183c4a", group=t];
 u0 [label="DECYZJA CZŁOWIEKA\nPotrzeba, granice, ryzyko\nNowe ustalenia, jeśli potrzebne", group=u];
 a0 [label="I · PRZYGOTOWANIE\nOdczytaj stan i decyzje\nZapisz plan oraz sprawdzenia", group=a];
 r0 [label="L1 · BRAK POWIĄZANIA\nKarta recenzenta istnieje.\nKto przypisze ją do przyrostu?", fillcolor="#fff0f0", color="#b94749", group=r];
 t0 [label="M · STRUKTURA I ŚLAD\nmake check: ID, relacje, pola\nNie ocenia pełnego planu", fillcolor="#e8f3ee", color="#35775a", group=t];
 u1 [label="", style=invis, group=u];
 a1 [label="I · WYKONANIE\nKod, testy i integracja\nZmiana poza mandatem → operator", group=a];
 r1 [label="I · PRZEKAZANIE\nZakres oceny, wersja,\nkryteria i źródła", group=r];
 t1 [label="M · RAPORT TESTÓW\nOsobne polecenie i runner\nBłąd runnera ≠ pass", fillcolor="#e8f3ee", color="#35775a", group=t];
 u2 [label="", style=invis, group=u];
 a2 [label="I · WYNIK DO OCENY\nProdukt + dowody + ograniczenia\nPoprawki wracają do sprawdzeń", group=a];
 r2 [label="I · PRZEGLĄD\nUstalenia z miejscem i dowodem\nBez poprawiania produktu", group=r];
 t2 [label="M · E9 PRZY COMMICIE\nRozdziela zmianę i nowy pass\nNie sprawdza tożsamości", fillcolor="#e8f3ee", color="#35775a", group=t];
 u3 [label="DECYZJA CZŁOWIEKA\nOdbiór przyrostu\nalbo potrzeba korekty", group=u];
 a3 [label="I · DEMONSTRACJA\nDziałający wynik\ni jawne ograniczenia", group=a];
 r3 [label="L2 · BRAK PEŁNEJ BRAMKI\nCzy potrzebny przegląd wykonano?\nCzy nadal dotyczy tej wersji?", fillcolor="#fff0f0", color="#b94749", group=r];
 t3 [label="M · W5 OSTRZEGA\nZmiana elementu lub rodzica\nNie bada całego kodu i danych", fillcolor="#e8f3ee", color="#35775a", group=t];
 u4 [label="OSOBNA DECYZJA\nWydanie produktu\nOdbiór ≠ uruchomienie CNC", group=u];
 a4 [label="I · WZNOWIENIE\nZapisz stan, blokady i następny krok\nNastępna sesja czyta źródła", group=a];
 r4 [label="L3 · ZALEŻNE OD PAMIĘCI\nInstrukcje wznowienia i wyzwalacze\nnie uruchamiają się same", fillcolor="#fff0f0", color="#b94749", group=r];
 t4 [label="M · RAPORT POSTĘPU\nGenerowany z zapisanych danych\nStatus zadania ≠ dowód wykonania", fillcolor="#e8f3ee", color="#35775a", group=t];
 {rank=same; hu; ha; hr; ht;}
 {rank=same; u0; a0; r0; t0;}
 {rank=same; u1; a1; r1; t1;}
 {rank=same; u2; a2; r2; t2;}
 {rank=same; u3; a3; r3; t3;}
 {rank=same; u4; a4; r4; t4;}
 edge [style=invis, weight=60];
 hu->ha->hr->ht; u0->a0->r0->t0; u1->a1->r1->t1; u2->a2->r2->t2; u3->a3->r3->t3; u4->a4->r4->t4;
 hu->u0->u1->u2->u3->u4; ha->a0->a1->a2->a3->a4; hr->r0->r1->r2->r3->r4; ht->t0->t1->t2->t3->t4;
 edge [style=solid, weight=1, constraint=false];
 u0->a0; a0->a1; a1->a2; a2->r2 [label="do oceny"]; r1->r2;
 r2->a3 [label="ustalenia"];
 r2->a1 [label="poprawka", color="#b94749", fontcolor="#b94749"];
 a3->u3; u3->u4 [label="odrębnie"];
 a3->a4;
 edge [style=dashed, color="#35775a"];
 a0->t0; a1->t1; r2->t2; a4->t4;
}
