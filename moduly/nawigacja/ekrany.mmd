%% Mapa ekranów i sterowania (moduł nawigacji). Przykład do zastąpienia własną mapą.
%% Konwencje (czyta je sprawdz.py):
%%   klasa ekran  = ekran z paskiem nawigacji (z każdego dostępne NAV)
%%   klasa modal  = przepływ pełnoekranowy bez paska; wyjście tylko krawędzią -.->
%%   klasa sukces = ekran zakończenia celu; zasada „prowadzenie do postępu” wymaga wezwania ==>
%%   klasa zewn   = aplikacja spoza systemu
%%   -->  zwykłe przejście     ==>  wezwanie do działania     -.->  wyjście / powrót
%%   %% wyjatek-zp01: Enn (D-nn) = świadomy wyjątek od reguły R5
%%   %% E-nn realizuje: UC-nn   = ślad ekranu do przypadku użycia (R7, narzedzia/id.toml)
%% E-01 realizuje: UC-01
%% E-02 realizuje: UC-01
%% E-03 realizuje: UC-01
%% E-04 realizuje: UC-01
%% E-05 realizuje: UC-01
flowchart LR
  NAV(["Pasek: Start · Lista · (+)"])

  E01["E-01 Start"]
  E02["E-02 Lista"]
  E03["E-03 Szczegóły"]
  E04["E-04 Formularz"]
  E05(["E-05 Zapisano"])

  NAV --> E01
  NAV --> E02
  NAV -->|"(+)"| E04

  E01 ==>|"Wezwanie: dokończ"| E03
  E01 -->|"Lista"| E02
  E02 -->|"Element"| E03
  E03 -.->|"Wstecz"| E02
  E03 -->|"Edytuj"| E04
  E04 ==>|"Zapisz"| E05
  E04 -.->|"Anuluj"| E01
  E05 ==>|"Pokaż element"| E03
  E05 -->|"Start"| E01

  classDef ekran fill:#e8eef6,stroke:#3d5a80,color:#1b2635
  classDef modal fill:#fdf0d5,stroke:#b07d18,color:#3a2a06
  classDef sukces fill:#dff1e3,stroke:#2f7d4a,color:#12301c
  classDef zewn fill:#eeeeee,stroke:#777777,color:#222222,stroke-dasharray:4 3
  classDef nav fill:#3d5a80,stroke:#3d5a80,color:#ffffff
  class E01,E02,E03 ekran
  class E04 modal
  class E05 sukces
  class NAV nav
